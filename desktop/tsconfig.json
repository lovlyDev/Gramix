{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@platform": [
        "./src/platform/desktop.ts"
      ],
      "@telemetry": [
        "./src/telemetry/noop.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "runtime/*.d.mts"
  ]
}
