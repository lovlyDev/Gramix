{
  "name": "gramix-desktop",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:runtimes && tsc -b && vite build",
    "build:runtimes": "esbuild runtime/sandbox-scenario.mjs --bundle --platform=node --format=cjs --target=node22 --outfile=runtime/bundle/sandbox-scenario.cjs && esbuild runtime/tolk-build.mjs --bundle --platform=node --format=cjs --target=node22 --outfile=runtime/bundle/tolk-build.cjs",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "tauri": "tauri",
    "build:web": "tsc -b && vite build --mode web",
    "dev:web": "vite --mode web",
    "test:e2e:web": "node tests/e2e/web.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "@ton/core": "0.63.1",
    "@ton/crypto": "3.3.0",
    "@ton/sandbox": "0.45.0",
    "@ton/tolk-js": "1.4.2",
    "@ton/ton": "16.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "buffer": "6.0.3",
    "lucide-react": "1.48.0",
    "monaco-editor": "0.57.0",
    "qrcode.react": "4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "5.5.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.1",
    "remark-gfm": "4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "5.0.2"
  }
}
