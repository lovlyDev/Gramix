{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gramix",
  "version": "0.6.0",
  "identifier": "app.gramix.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Gramix",
      "width": 1360,
      "height": 850,
      "minWidth": 1000,
      "minHeight": 680,
      "backgroundColor": "#000000"
    }],
    "security": { "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cache.tonapi.io" }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/gramix"],
    "resources": {
      "../../data/ton-english.txt": "data/ton-english.txt",
      "../../gpu/vulkan/derive.spv": "gpu/vulkan/derive.spv",
      "../runtime/bundle/sandbox-scenario.cjs": "runtime/sandbox-scenario.cjs",
      "../runtime/bundle/tolk-build.cjs": "runtime/tolk-build.cjs",
      "../../docs/licenses/node-24.18.0.LICENSE": "licenses/node.LICENSE",
      "../../docs/licenses/ton-sandbox.LICENSE": "licenses/ton-sandbox.LICENSE",
      "../../docs/licenses/ton-tolk-js.LICENSE": "licenses/ton-tolk-js.LICENSE",
      "../../docs/licenses/ton-core.LICENSE": "licenses/ton-core.LICENSE",
      "../../docs/licenses/buffer.LICENSE": "licenses/buffer.LICENSE"
    },
    "windows": {
      "bundleVCRuntime": true,
      "nsis": { "installMode": "currentUser", "languages": ["Russian", "English"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5QjA5MUY2OUUxQ0U1RTkKUldUcDVSeWU5cEd3R2FQekNBNGVMNzhHMFRka1E2L2x3a3hCRFo5TU81OHpPSENuWXF2Lzd3NWUK",
      "endpoints": ["https://github.com/lovlyDev/Gramix/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
