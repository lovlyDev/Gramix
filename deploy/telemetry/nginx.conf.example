# Поддомен для сборщика. Подставьте свой домен вместо stats.example.ru
# и выпустите сертификат (certbot или панель хостинга).
server {
    listen 443 ssl http2;
    server_name stats.example.ru;

    # ssl_certificate     /etc/letsencrypt/live/stats.example.ru/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/stats.example.ru/privkey.pem;

    client_max_body_size 64k;
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
